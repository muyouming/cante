{
  // Editor + `pocket check` configuration for the app graph.
  //
  // babel-preset-solid owns the JSX transform (jsx stays "preserve"), and
  // PocketJS's compiler injects the generated class table at build time, so
  // there are no runtime style imports to wire here.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": [],
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["main.tsx", "app.tsx", "src/**/*.ts", "src/**/*.tsx"]
}
