    "check": "bash scripts/pocket.sh check",
    "dev": "bash scripts/pocket.sh dev"
  },
  "dependencies": {
    "@pocketjs/framework": "0.11.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.2"
  }
}
