{
  "name": "cante-gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PocketJS GUI client for Cante, plus the loopback HTTP bridge it talks to.",
  "scripts": {
    "bridge": "bun bridge/cante-bridge.ts",
    "test": "bun test bridge src",
