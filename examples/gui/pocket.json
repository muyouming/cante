{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.cante.gui",
  "name": "cante-gui",
  "title": "Cante",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": ["input.buttons", "text.glyphs.baked"],
      "enhances": [
        "display.viewport.live",
        "input.touch",
        "input.pointer",
        "input.cursor",
        "input.ime",
        "input.text",
        "text.glyphs.runtime",
        "net.http"
      ]
    }
  },
  "app": {
    "entry": "main.tsx",
    "output": "cante-gui-main",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [480, 272],
        "presentation": "integer-fit"
      },
      "dynamic": {
        "default": [1100, 720]
      }
    }
  }
}
