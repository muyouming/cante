{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cante",
  "version": "0.2.2",
  "identifier": "dev.cante.gui",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "beforeBuildCommand": "bun scripts/stage-executor.ts && bun run build:web",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cante",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Cante desktop client",
    "longDescription": "A graphical client for the Cante coding agent: session rail, streaming transcript, tool cards and approvals.",
    "copyright": "Copyright © 2026 Antigma Labs",
    "licenseFile": "../../LICENSE",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
